# Zentinel AIOps Environment Configuration

# Server Settings
ZENTINEL_HOST=127.0.0.1
ZENTINEL_PORT=8000
WEB_CONCURRENCY=1
ZENTINEL_ENV=production

# Database & Storage
ZENTINEL_DB_PATH=data/processed/zentinel_live.sqlite3

# Security & Authentication
# Comma-separated list of role:sha256_hash or sha256_hash (defaults to admin role).
# Generate a hash locally with:
#   python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" your-key
# Verified hashes for the example keys below:
#   admin-secret-key-12345  -> 859277c52809684699b1611f20517931b17356c7856ffa0dc5b24e038534eb9c
#   ingest-secret-key-12345 -> f5a8f0c4b908097851c71bf38cb49309f9327f8d74a597ee7b0c415b3bf32721
#   read-secret-key-12345   -> bafbe36a9f603589b5ae57c5b5969c66f5556b48a760d63408a0b849e55a1d79
ZENTINEL_API_KEY_SHA256=admin:859277c52809684699b1611f20517931b17356c7856ffa0dc5b24e038534eb9c,ingest:f5a8f0c4b908097851c71bf38cb49309f9327f8d74a597ee7b0c415b3bf32721,read:bafbe36a9f603589b5ae57c5b5969c66f5556b48a760d63408a0b849e55a1d79

# CORS Allowed Origins (comma-separated)
ZENTINEL_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8502,http://127.0.0.1:8502

# Rate Limiting (Token Bucket: requests per second)
ZENTINEL_RATE_LIMIT_RPS=100.0
ZENTINEL_RATE_LIMIT_BURST=200

# Retention Policy (Days)
ZENTINEL_IDEMPOTENCY_RETENTION_DAYS=7
ZENTINEL_EVENT_RETENTION_DAYS=30
