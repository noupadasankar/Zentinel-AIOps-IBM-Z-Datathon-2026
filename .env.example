# Zentinel AIOps Environment Configuration

# Server Settings
ZENTINEL_HOST=127.0.0.1
ZENTINEL_PORT=8001
WEB_CONCURRENCY=1
ZENTINEL_ENV=production

# Database & Storage
ZENTINEL_DB_PATH=data/processed/zentinel_live.sqlite3

# Security & Authentication
# Comma-separated list of role:sha256_hash or sha256_hash (defaults to admin role)
# Example below is SHA-256 for:
# admin-secret-key-12345 -> a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3
# ingest-secret-key-12345 -> 7d04f29235e236357cc210166299b821f7ab2c10b7794ff0630b5d564fa7e262
# read-secret-key-12345 -> 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
ZENTINEL_API_KEY_SHA256=admin:a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3,ingest:7d04f29235e236357cc210166299b821f7ab2c10b7794ff0630b5d564fa7e262,read:2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824

# CORS Allowed Origins (comma-separated)
ZENTINEL_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8502,http://127.0.0.1:8502

# Rate Limiting (Token Bucket: requests per second)
ZENTINEL_RATE_LIMIT_RPS=100.0
ZENTINEL_RATE_LIMIT_BURST=200

# Retention Policy (Days)
ZENTINEL_IDEMPOTENCY_RETENTION_DAYS=7
ZENTINEL_EVENT_RETENTION_DAYS=30
